{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/nonogram-village/level.schema.json",
  "title": "Nonogram Level",
  "type": "object",
  "required": ["schemaVersion", "id", "width", "height", "solution"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 3, "maximum": 25 },
    "height": { "type": "integer", "minimum": 3, "maximum": 25 },
    "difficulty": { "type": "string", "enum": ["easy", "normal", "hard"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "solution": {
      "description": "Array of strings. Each string is a row of 0/1 chars. Length must equal width.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
